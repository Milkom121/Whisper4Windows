# Auto detect text files and perform LF normalization
* text=auto

# Metodo Villa: shell scripts require LF; preserve native Windows launchers.
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.env text eol=lf
crontab text eol=lf
Dockerfile text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
